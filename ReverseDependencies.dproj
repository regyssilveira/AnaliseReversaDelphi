<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{F8504C65-A9ED-4AA8-B2D9-9009A99CBF91}</ProjectGuid>
    <ProjectVersion>19.0</ProjectVersion>
    <MainSource>ReverseDependencies.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!='' or '$(Config)'!=''">
    <DCC_UnitSearchPath>src;vendor\DelphiAST\Source;vendor\DelphiAST\Source\SimpleParser;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Winapi;Vcl;Xml;$(DCC_Namespace)</DCC_Namespace>
    <DCC_ExeOutput>bin</DCC_ExeOutput>
    <DCC_DcuOutput>obj</DCC_DcuOutput>
  </PropertyGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
